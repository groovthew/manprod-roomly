# =====================================================
# Konfigurasi SMTP untuk pengiriman email receipt
# =====================================================
# JIKA TIDAK DIISI: backend pakai mode DEMO (Ethereal)
# - Email tidak benar-benar terkirim ke alamat asli
# - Tapi backend balas dengan "preview URL" untuk
#   melihat persis tampilan email yang dikirim
# =====================================================

# === Gmail (paling umum) ===
# 1. Aktifkan 2-Step Verification di akun Google Anda
# 2. Buat "App Password" di myaccount.google.com/apppasswords
# 3. Pakai password 16-karakter itu di SMTP_PASS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alamat-anda@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM="Roomly <noreply@roomly.id>"

# === SendGrid ===
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxx

# === Mailgun ===
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=xxxxxxxxxx

# === Server settings ===
# PORT=3001
